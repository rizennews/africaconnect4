# ==============================================================================
# AfricaConnect4 Environment Configuration Template
# Duplicate this file as .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Site and Canonical SEO URL
# ------------------------------------------------------------------------------
# Domain URL used for metadataBase, Open Graph, Twitter cards, XML sitemaps,
# robots.txt, and Schema.org JSON-LD canonical entity links.
NEXT_PUBLIC_SITE_URL=https://africaconnect4.wacren.net

# ------------------------------------------------------------------------------
# 2. CAPTCHA Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=ae2e523e-55da-4d2e-a11a-d2acf6f0fc28
HCAPTCHA_SECRET_KEY=0x0000000000000000000000000000000000000000

# ------------------------------------------------------------------------------
# 2. Contact Form & SMTP Mailer Configuration
# ------------------------------------------------------------------------------
# SMTP server hostname (e.g., smtp.gmail.com, mail.wacren.net, smtp.sendgrid.net)
SMTP_HOST=smtp.example.com

# SMTP server port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587

# Set to true for port 465 (SSL), false for port 587 (STARTTLS)
SMTP_SECURE=false

# Authenticated SMTP username or sender address
SMTP_USER=secretariat@wacren.net

# Authenticated SMTP password or App-specific Password
SMTP_PASSWORD=your_smtp_password_here

# Destination inbox for website contact form inquiries
CONTACT_EMAIL_TO=secretariat@wacren.net
